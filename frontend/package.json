{
  "name": "travel-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm paraglide:compile && tsc -b && vite build",
    "check": "pnpm paraglide:compile && tsc -b",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm paraglide:compile && vitest run",
    "preview": "vite preview",
    "e2e": "playwright test",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy custom-travel baseLocale --emit-ts-declarations",
    "locale:audit": "node scripts/locale-audit.mjs",
    "check-message-parity": "node scripts/check-message-parity.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@vitejs/plugin-react": "latest",
    "cn": "^0.4.0",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "6.13.0",
    "react": "latest",
    "react-day-picker": "^10.0.2",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@inlang/paraglide-js": "^2.26.0",
    "@playwright/test": "^1.64.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "oxc-parser": "^0.148.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

{
  "name": "travel-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm paraglide:compile && tsc -b && vite build",
    "check": "pnpm paraglide:compile && tsc -b",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm paraglide:compile && vitest run",
    "preview": "vite preview",
    "bundle": "node scripts/bundle-report.mjs",
    "bundle:check": "node scripts/bundle-report.mjs --check",
    "e2e": "playwright test",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy custom-travel baseLocale --emit-ts-declarations",
    "locale:audit": "node scripts/locale-audit.mjs",
    "check-message-parity": "node scripts/check-message-parity.mjs",
    "ui:check": "node scripts/ui-maintenance.mjs check && node scripts/ui-imports.mjs",
    "ui:upstream": "node scripts/ui-maintenance.mjs upstream",
    "ui:diff": "node scripts/ui-maintenance.mjs diff",
    "ui:record": "node scripts/ui-maintenance.mjs record",
    "ui:test": "node --test scripts/ui-maintenance.verify.mjs scripts/ui-imports.verify.mjs",
    "ui:usage": "node scripts/ui-imports.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@vitejs/plugin-react": "latest",
    "cn": "^0.5.0",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "6.15.0",
    "react": "latest",
    "react-day-picker": "^10.0.2",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@inlang/paraglide-js": "^2.29.1",
    "@playwright/test": "^1.64.0",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.3",
    "msw": "^3.0.3",
    "oxc-parser": "^0.155.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "shadcn": "4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}

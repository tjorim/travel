{
  "name": "travel-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm paraglide:compile && tsc -b && vite build",
    "check": "pnpm paraglide:compile && tsc -b",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm paraglide:compile && vitest run",
    "preview": "vite preview",
    "bundle": "node scripts/bundle-budget.mjs",
    "bundle:check": "node scripts/bundle-budget.mjs --check",
    "e2e": "playwright test",
    "e2e:offline": "pnpm build && playwright test -c playwright.offline.config.ts",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy custom-travel baseLocale --emit-ts-declarations",
    "locale:audit": "node scripts/locale-audit.mjs",
    "check-message-parity": "node scripts/check-message-parity.mjs",
    "ui:check": "node scripts/ui-maintenance.mjs check && node scripts/ui-imports.mjs",
    "ui:upstream": "node scripts/ui-maintenance.mjs upstream",
    "ui:diff": "node scripts/ui-maintenance.mjs diff",
    "ui:record": "node scripts/ui-maintenance.mjs record",
    "ui:test": "node --test scripts/ui-maintenance.verify.mjs scripts/ui-imports.verify.mjs",
    "ui:usage": "node scripts/ui-imports.mjs",
    "bundle:report": "node scripts/bundle-budget.mjs",
    "bundle:test": "node --test scripts/bundle-budget.verify.mjs",
    "test:compatibility:runtime": "vitest run -c vitest.redact.config.ts",
    "test:compatibility:browsers": "playwright test -c playwright.compatibility.config.ts",
    "test:compatibility": "pnpm test:compatibility:runtime && pnpm test:compatibility:browsers"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@vitejs/plugin-react": "^6.2.1",
    "cn": "^0.5.2",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "6.16.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@inlang/paraglide-js": "^3.2.0",
    "@playwright/test": "^1.65.0",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.106.1",
    "@tanstack/redact": "0.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.4",
    "oxc-parser": "^0.157.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}

{
  "repo": "tjorim/travel",
  "targets": [
    {
      "file": "backend/app/main.py",
      "pattern": "version=\"([^\"]+)\","
    },
    {
      "file": "backend/app/mcp_server.py",
      "pattern": "version=\"([^\"]+)\","
    },
    {
      "file": "custom_components/travel/diagnostics.py",
      "pattern": "\"integration_version\": \"([^\"]+)\""
    },
    {
      "file": "custom_components/travel/manifest.json",
      "pattern": "(?:\"version\": \"|python-travel==)([^\"]+)\"",
      "expect": 2
    },
    {
      "file": "frontend/package.json",
      "pattern": "\"version\": \"([^\"]+)\""
    },
    {
      "file": "python-travel/pyproject.toml",
      "pattern": "\\nversion = \"([^\"]+)\""
    },
    {
      "file": "home-assistant/uv.lock",
      "pattern": "name = \"python-travel\"\\nversion = \"([^\"]+)\""
    },
    {
      "file": "backend/uv.lock",
      "pattern": "name = \"python-travel\"\\nversion = \"([^\"]+)\""
    },
    {
      "file": "python-travel/uv.lock",
      "pattern": "name = \"python-travel\"\\nversion = \"([^\"]+)\""
    },
    {
      "file": "home-assistant/README.md",
      "pattern": "currently (\\d{4}\\.\\d+\\.\\d+)"
    },
    {
      "file": "home-assistant/tests/test_travel.py",
      "pattern": "\"integration_version\": \"([^\"]+)\""
    }
  ],
  "scopes": ["Web", "Backend", "MCP", "Home Assistant", "Python client"],
  "platforms": ["Web"]
}

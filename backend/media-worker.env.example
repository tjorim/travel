# Required for video derivatives: there is no in-process encoder.
# Backend/dispatcher-only origin; no browser/public route.
TRAVEL_MEDIA_WORKER_URL=http://media-worker:8090
TRAVEL_MEDIA_WORKER_TOKEN_FILE=/run/secrets/media_travel_token
TRAVEL_MEDIA_WORKER_PROFILE=travel-video-v1
# Dispatcher additionally needs the SAME TRAVEL_DATABASE_URL and
# TRAVEL_MEDIA_STORAGE_ROOT as the API. Never mount canonical storage into the
# encoder worker. Keep worker MEDIA_TOMBSTONE_SECONDS >= 604800.

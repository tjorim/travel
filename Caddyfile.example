# Copy this block to Caddyfile on the VPS and replace the domain. The
# deployment-managed password hash and session key live only in travel-auth.env.

travel.example.com {
	root * /srv/travel
	encode zstd gzip

	# The auth service owns /login and /logout. Protect shared documents and
	# any trip-private route before Caddy serves its static file.
	@auth-pages path /login /logout
	reverse_proxy @auth-pages travel-auth:8080

	@private path /private /private/* /*/private /*/private/*
	forward_auth @private travel-auth:8080 {
		uri /verify
	}

	file_server
}

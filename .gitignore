.env
*.env
*.db
*.sqlite
*.sqlite3
*.bundle
*.dump
uploads/
backups/
privacy-audit/
frontend/playwright-report/
__pycache__/
*.pyc

# Personal-instance archive retained on disk, outside public source.
/dist/

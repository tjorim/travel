{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tjorim/renovate-config",
    "github>tjorim/renovate-config:js",
    "github>tjorim/renovate-config:python"
  ],
  "packageRules": [
    {
      "description": [
        "Review the map renderer and its scoped dependencies together"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "maplibre-gl",
        "@maplibre/*"
      ],
      "groupName": "maplibre"
    },
    {
      "description": [
        "Transitive packages that would otherwise get one PR each"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "baseline-browser-mapping",
        "enhanced-resolve",
        "ip-address",
        "@napi-rs/wasm-runtime"
      ],
      "groupName": "transitive"
    },
    {
      "description": [
        "timezonefinder ships its data as a separate package"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "timezonefinder",
        "timezonefinder-data"
      ],
      "groupName": "timezonefinder"
    },
    {
      "description": [
        "frontend/**"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/**"
      ],
      "addLabels": [
        "platform:frontend"
      ]
    },
    {
      "description": [
        "backend/**"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchFileNames": [
        "backend/**"
      ],
      "addLabels": [
        "platform:backend"
      ],
      "commitMessagePrefix": "deps(backend):"
    }
  ]
}
